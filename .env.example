# Edgecast configuration. Copy to .env and fill in. Every value is validated at startup (app/config.py);
# the process refuses to start on a bad value. Never commit .env.

# --- Mode & safety ---
# startup default: SCAN | PAPER | LIVE (switchable at runtime; DB value wins once set)
MODE=SCAN
# true = env MODE overrides the mode saved in DB on restart (and locks runtime switching)
MODE_FORCE_ENV=false
# must equal I_ACCEPT_LOSSES to allow LIVE at all
LIVE_CONFIRM=
# true = block LIVE until PAPER has run PAPER_MIN_DAYS (otherwise just a warning)
REQUIRE_PAPER_BEFORE_LIVE=false
# suggested/required PAPER duration before LIVE
PAPER_MIN_DAYS=14
# starting bankroll for PAPER sizing (LIVE sizes on its real equity)
BANKROLL_USD=200
# ceilings that UI/Telegram can never exceed
HARD_MAX_STAKE_PER_ORDER_USD=50
# ceiling for total / per-market / per-city-day exposure overrides
HARD_MAX_TOTAL_EXPOSURE_USD=300
# ceiling for the daily loss limit override
HARD_MAX_DAILY_LOSS_USD=60
# max cost (price + fees) of a single order
MAX_STAKE_PER_ORDER_USD=10
# max open cost basis in one bucket market
MAX_EXPOSURE_PER_MARKET_USD=20
# max open cost basis across all buckets of one city on one day
MAX_EXPOSURE_PER_CITY_DAY_USD=30
# max open cost basis across everything (resting orders count)
MAX_TOTAL_EXPOSURE_USD=100
# realised loss today (TZ) that triggers an automatic halt
MAX_DAILY_LOSS_USD=20
# equity drawdown from peak that triggers an automatic halt
MAX_DRAWDOWN_PCT=15
# fraction of full Kelly used for sizing
KELLY_FRACTION=0.15

# --- Edge & execution ---
# minimum p_model - ask - fee to trade (6 percentage points)
MIN_EDGE=0.06
# edges above this are treated as a parsing bug: skip and log
SANITY_MAX_EDGE=0.40
# skip markets whose bid/ask spread is wider than this
MAX_SPREAD_CENTS=6
# never post a limit more than this above the best ask
MAX_SLIPPAGE_CENTS=1
# skip if visible notional at or below our limit is smaller than this
MIN_LIQUIDITY_USD=50
# never take more than this % of visible depth at our price
MAX_BOOK_DEPTH_PCT=25
# no entries later than this many hours before the observation day ends
ENTRY_MIN_HOURS=6
# no entries earlier than this many hours before the observation day ends
ENTRY_MAX_HOURS=72
# no entries this close to the market's trading close (endDate)
NO_NEW_ENTRY_HOURS_BEFORE_CLOSE=2
# how often exits are re-evaluated
REEVAL_MINUTES=30
# take profit when bid >= p_model - TP_BUFFER
TP_BUFFER=0.02
# exit when a new forecast puts p_model below the bid by this much
EXIT_EDGE=0.03

# --- Markets ---
# trade daily high/low temperature markets
ENABLE_WEATHER=true
# phase 2 CPI module (built, not wired to live data; keep false)
ENABLE_CPI=false
# empty = all parsable cities; else comma list, e.g. nyc,london,chicago
CITY_ALLOWLIST=
# comma list of cities never to trade
CITY_BLOCKLIST=
# auto-disable a city whose 30-day Brier score exceeds this (n >= 20)
MAX_BRIER=0.20

# --- Forecast ---
# model families and blend weights (ecmwf_ifs, gfs, ecmwf_aifs, icon, gem)
MODEL_WEIGHTS=ecmwf_ifs:0.6,gfs:0.4
# forecasts pulled longer ago than this are stale: no trading
MAX_FORECAST_AGE_MIN=360
# ensemble members
OPEN_METEO_BASE=https://ensemble-api.open-meteo.com
# lead-specific history (bias fits, backtest)
OPEN_METEO_PREVIOUS_RUNS_BASE=https://previous-runs-api.open-meteo.com
# specific past runs
OPEN_METEO_SINGLE_RUNS_BASE=https://single-runs-api.open-meteo.com
# reserved
OPEN_METEO_HISTORICAL_FORECAST_BASE=https://historical-forecast-api.open-meteo.com
# station METAR archive = resolution-source truth for bias fitting
IEM_BASE=https://mesonet.agron.iastate.edu
# NWS point forecast (US cross-check)
NWS_BASE=https://api.weather.gov
# NWS requires a contact in the User-Agent
NWS_USER_AGENT=edgecast (you@example.com)

# --- Polymarket ---
# dedicated hot wallet ONLY (LIVE). Leave empty for SCAN/PAPER. Or use POLY_PRIVATE_KEY_FILE
POLY_PRIVATE_KEY=
# path to a file containing the key (e.g. a Docker secret); not both
POLY_PRIVATE_KEY_FILE=
# only if trading through a Polymarket proxy/safe wallet; empty = plain EOA (recommended)
POLY_FUNDER_ADDRESS=
# optional sanity check: 0 EOA, 1 proxy, 2 safe, 3 EIP-1271 (the SDK detects it)
POLY_SIGNATURE_TYPE=
# order books, orders, fees
POLY_CLOB_URL=https://clob.polymarket.com
# market discovery
POLY_GAMMA_URL=https://gamma-api.polymarket.com
# public positions (manual wallet import)
POLY_DATA_URL=https://data-api.polymarket.com
# checked at startup and hourly
POLY_GEOBLOCK_URL=https://polymarket.com/api/geoblock
# Polygon mainnet
POLY_CHAIN_ID=137
# optional; the SDK uses its own default RPC if empty
POLYGON_RPC_URL=
# your MAIN wallet's public address, used only by scripts/withdraw.py
WITHDRAW_TO_ADDRESS=

# --- App ---
# SQLite (WAL) by default; Postgres: postgresql+psycopg://user:pw@host/db
DATABASE_URL=sqlite:////data/edgecast.db
# DB, logs, backups, KILL file
DATA_DIR=/data
# dashboard login
UI_USERNAME=admin
# generate with: python -m app.tools.hash_password  (keep the single quotes it prints)
UI_PASSWORD_HASH=
# >= 16 random chars, e.g. python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Caddy issues HTTPS for this name; point its DNS A record at the server first
PUBLIC_DOMAIN=bot.example.com
# local time zone for "today", daily summary and quiet hours (IANA name)
TZ=UTC
# DEBUG | INFO | WARNING
LOG_LEVEL=INFO
# optional s3://bucket/prefix for nightly DB backups (needs the aws CLI + credentials)
BACKUP_S3_URI=

# --- Scanner / manual trading ---
# sizing base for suggested manual stakes (separate from the bot bankroll)
MANUAL_BANKROLL_USD=200
# cap on suggested manual stake per signal
MANUAL_MAX_STAKE_USD=25
# optional public address to auto-import manual positions (never its key)
MANUAL_WALLET_ADDRESS=
# re-alert a signal only if its edge moves more than this (or it flips)
SIGNAL_REALERT_EDGE_DELTA=0.03
# LOW | MED | HIGH, minimum to alert
MIN_SIGNAL_CONFIDENCE=MED

# --- Telegram control bot ---
# true to run the bot inside the worker
TELEGRAM_ENABLED=false
# from @BotFather
TELEGRAM_BOT_TOKEN=
# comma-separated numeric user IDs; everyone else ignored (and logged)
TELEGRAM_ALLOWED_USER_IDS=
# where push alerts go (your user ID for a private chat)
TELEGRAM_CHAT_ID=
# push new signals
TELEGRAM_NOTIFY_SIGNALS=true
# push order placed/filled/partial/cancelled
TELEGRAM_NOTIFY_ORDERS=true
# push exit signals and executed exits
TELEGRAM_NOTIFY_EXITS=true
# push resolutions with P&L
TELEGRAM_NOTIFY_RESOLUTIONS=true
# local (TZ) time for the daily summary
TELEGRAM_DAILY_SUMMARY_TIME=21:00
# local (TZ) window muting everything except risk and health alerts
TELEGRAM_QUIET_HOURS=00:30-07:00
